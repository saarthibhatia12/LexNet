# ============================================================================
# LexNet Root Environment Reference
# ============================================================================
# This file is a consolidated reference for local development. Individual
# services still load their own .env files:
#   - backend/.env
#   - nlp/.env
#   - hardware-bridge/.env
#   - frontend/.env
#
# Keep JWT_SECRET identical in backend/.env and hardware-bridge/.env.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-32-char-minimum-secret
JWT_EXPIRY=1h
FABRIC_CHANNEL=lexnet-channel
FABRIC_CHAINCODE=lexnet-cc
FABRIC_WALLET_PATH=./wallet
FABRIC_CONNECTION_PROFILE=./connection-org1.json
FABRIC_MSP_ID=GovtOrgMSP
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexnet-neo4j-pass
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NLP_SERVICE_URL=http://localhost:5500
VERIFICATION_BASE_URL=http://localhost:3000
LOG_LEVEL=info
MAX_FILE_SIZE_MB=50

# ---------------------------------------------------------------------------
# NLP (nlp/.env)
# ---------------------------------------------------------------------------
# NLP reuses:
#   NEO4J_URI
#   NEO4J_USER
#   NEO4J_PASSWORD
#   IPFS_API_URL
FLASK_PORT=5500
NER_MODEL_PATH=./models/legal-bert
SPACY_MODEL=en_core_web_sm
TESSERACT_CMD=tesseract
CONFLICT_MODEL_PATH=./data/conflict_model.pkl

# ---------------------------------------------------------------------------
# Hardware bridge (hardware-bridge/.env)
# ---------------------------------------------------------------------------
# Hardware bridge reuses JWT_SECRET from the backend section above.
SERIAL_PORT=COM3
BAUD_RATE=57600
API_URL=http://localhost:4000
BRIDGE_LOG_LEVEL=INFO
TIMESTAMP_TOLERANCE_SEC=30
MIN_FINGER_SCORE=60

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/graphql
VITE_REST_API_URL=http://localhost:4000/api
VITE_APP_NAME=LexNet

# ---------------------------------------------------------------------------
# Optional data utility settings
# ---------------------------------------------------------------------------
# Used by data/scripts/fetch_indiankanoon.py. This follows the Indian Kanoon
# shared-token authentication flow documented at:
# https://api.indiankanoon.org/documentation/
INDIANKANOON_API_TOKEN=
